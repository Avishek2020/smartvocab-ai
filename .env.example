# Copy to .env and adjust. Never commit .env.
# Every setting maps 1:1 to a field in backend/app/core/config.py (case-insensitive).
# Keep comments on their own lines: some .env parsers treat "value  # comment" as part of the value.

# ── App ─────────────────────────────────────────────────────────────
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated. Only needed if a browser calls the API directly (the Next.js proxy doesn't need it).
CORS_ORIGINS=http://localhost:3000

# ── Database & cache ────────────────────────────────────────────────
# Used by docker-compose for the Postgres container.
POSTGRES_PASSWORD=smartvocab
# Postgres port on your PC. Change it if 5433 is also taken.
POSTGRES_HOST_PORT=5433
# Used when running the backend outside Docker (inside Docker, compose sets its own value).
DATABASE_URL=postgresql+psycopg://smartvocab:smartvocab@localhost:5433/smartvocab
REDIS_URL=redis://localhost:6379/0

# ── Auth ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-development-only-0123456789
# 7 days
ACCESS_TOKEN_MINUTES=10080
# MUST be true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── AI providers (Phase 3+). Leave as "none" until configured. ──────
# anthropic | openai | openai_compatible | none
LLM_PROVIDER=none
# Main model for extraction, grammar and tutor; and a cheaper one for bulk passes.
LLM_MODEL=
LLM_FAST_MODEL=
# Only for openai_compatible (e.g. a self-hosted vLLM server)
LLM_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# openai | faster_whisper | none
STT_PROVIDER=none
# azure | openai | piper | none
TTS_PROVIDER=none

# ── Uploads & storage (Phase 2+) ────────────────────────────────────
MAX_UPLOAD_MB=50
STORAGE_BUCKET=smartvocab
# e.g. http://minio:9000 locally; leave empty for AWS S3
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Frontend ────────────────────────────────────────────────────────
# Where Next.js proxies /api/v1/* when running outside Docker.
BACKEND_URL=http://localhost:8000
